# ==========================================
# EstateFlow Real Estate CRM - Environment Template
# ==========================================

# Flask Server Config
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=replace_with_a_secure_random_key_in_production
JWT_SECRET_KEY=replace_with_a_secure_jwt_secret_key_in_production

# MongoDB Connection (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017/real_estate_crm
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/real_estate_crm?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/real_estate_crm

# Optional Port Override
PORT=5000
